# Optional: Server-side API key for /api/ai/plan and /api/ai/document-assist.
# All local browser-based processing tools work without setting this variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server listening port (defaults to 3000).
PORT="3000"

# Optional public base URL for deployments.
APP_URL="http://localhost:3000"

